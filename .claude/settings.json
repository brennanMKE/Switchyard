{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(bat .env*)",
      "Bash(open .env*)",
      "Bash(source .env*)",
      "Bash(dotenv *)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(export -p)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyRead": [
        ".env",
        ".env.local",
        ".env.*.local"
      ]
    }
  }
}
